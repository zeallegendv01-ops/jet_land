# Example environment variables for the server
# Telegram bot token (single bot)
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Optional: Telegram chat id to receive contact form notifications and alerts
# TELEGRAM_ADMIN_CHAT=123456789
# Optional: set to true for local polling (instead of using webhooks)
# TELEGRAM_POLLING=true
# Public server URL used to register webhook (optional)
SERVER_URL=https://yourdomain.example
# Port the server should listen on
PORT=3400
# MongoDB Atlas or self-hosted MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/jetland?retryWrites=true&w=majority
